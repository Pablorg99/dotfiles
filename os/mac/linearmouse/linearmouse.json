{
  "$schema": "https://schema.linearmouse.app/0.12.0",
  "schemes": [
    {
      "buttons": {
        "mappings": [
          {
            "outcomes": {
              "shortPress": {
                "keyPress": [
                  "shift",
                  "command",
                  "s"
                ]
              }
            },
            "trigger": {
              "input": {
                "button": {
                  "controlID": 195,
                  "kind": "logitechControl",
                  "productID": 45108
                }
              }
            }
          }
        ]
      },
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0xb034",
          "productName": "MX Master 3S",
          "vendorID": "0x46d"
        }
      },
      "scrolling": {
        "acceleration": {
          "vertical": 1
        },
        "distance": {
          "vertical": "auto"
        },
        "modifiers": {
          "horizontal": {
            "command": {
              "type": "auto"
            }
          },
          "vertical": {
            "command": {
              "type": "pinchZoom"
            }
          }
        },
        "reverse": {
          "vertical": true
        },
        "smoothed": {
          "vertical": {
            "enabled": false
          }
        },
        "speed": {
          "vertical": 0
        }
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0xc539",
          "productName": "USB Receiver",
          "vendorID": "0x46d"
        }
      },
      "scrolling": {
        "reverse": {
          "vertical": true
        }
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0x1b3e",
          "productName": "Corsair Gaming SCIMITAR PRO RGB Mouse",
          "vendorID": "0x1b1c"
        }
      },
      "scrolling": {
        "reverse": {
          "vertical": true
        }
      }
    }
  ]
}
